# Environnement local Javeroo-Billeterie (NE PAS COMMITER .env.local)
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base de données PostgreSQL (isolée par environnement : dev / staging / prod)
DATABASE_URL=postgresql://javeroo:javeroo_dev_password@localhost:5432/javeroo_dev

# Redis (holds temporaires, rate-limiting, files de tâches)
REDIS_URL=redis://localhost:6379

# Signature cryptographique des QR codes & sessions HttpOnly (64 car. aléatoires en prod)
TICKET_SIGNING_SECRET=dev-only-change-me-in-production-64-chars-minimum-secret-key-javeroo
SESSION_SECRET=dev-session-secret-change-me-in-production-64-chars-javeroo-uemoa

# Paiements UEMOA (sandbox en dev, cinetpay ou pawapay en prod)
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-in-production
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
PAWAPAY_API_TOKEN=
PAWAPAY_API_URL=https://api.sandbox.pawapay.io

# Stockage affiches publiques (Vercel Blob recommandé sur Vercel, sinon Cloudflare R2)
BLOB_READ_WRITE_TOKEN=
R2_PUBLIC_BASE_URL=https://cdn.javeroo.com
R2_PUBLIC_BUCKET=javeroo-public-dev
R2_PRIVATE_BUCKET=javeroo-private-dev

# Comptes SuperAdmin de production (équipe Javeroo — jusqu'à SUPER_ADMIN_10_*)
# Fonctionne en production même quand ENABLE_DEMO_ACCOUNTS=false (mots de passe >= 8 car.)
SUPER_ADMIN_1_NAME=Direction Javeroo
SUPER_ADMIN_1_EMAIL=
SUPER_ADMIN_1_PASSWORD=
SUPER_ADMIN_1_PHONE=

SUPER_ADMIN_2_NAME=Elvis Jethro
SUPER_ADMIN_2_EMAIL=
SUPER_ADMIN_2_PASSWORD=
SUPER_ADMIN_2_PHONE=

# Comptes démo Organisateur/Admin (mettre false en vraie production)
ENABLE_DEMO_ACCOUNTS=false
NEXT_PUBLIC_ENABLE_DEMO_ACCOUNTS=false

# Notifications multi-canal (optionnelles en dev — journalisées en mémoire si vides)
RESEND_API_KEY=
EMAIL_FROM=Javeroo Billetterie <billets@javeroo.com>
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Cron de libération automatique des réservations expirées (> 10 min)
CRON_SECRET=dev-cron-secret-change-me

